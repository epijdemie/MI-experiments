/shelves/
/stages/
/streams/
/tides/
/tides2/
/tools/
/veils/
/volts/
/yarns/

# clouds — only dsp/fx/fx_engine.h is needed (used by warps_reverb).
# Ignore everything else under clouds/ but keep that one header tracked.
/clouds/*
!/clouds/dsp/
/clouds/dsp/*
!/clouds/dsp/fx/
/clouds/dsp/fx/*
!/clouds/dsp/fx/fx_engine.h
